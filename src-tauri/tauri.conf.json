{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nakraku Stash",
  "version": "0.1.0",
  "identifier": "com.nakraku.stash",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nakraku Stash",
        "width": 900,
        "height": 600,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: asset: https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:48123"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["en-US"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/Square150x150Logo.png",
        "sidebarImage": "icons/Square150x150Logo.png"
      },
      "wix": {
        "language": ["en-US"],
        "upgradeCode": "8B3D9D5E-5D2B-4E38-92FE-7389AA8C1523"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nakraku/nakraku-stash/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBODkzRThCNzlGNEJBOTAKUldUZVlscG5QOU5lYndQY2t1SEc5M01jWVhkc1k3c3IrdWhaWkVQcEdJOHQxV3B3cURlUW95NGIK"
    }
  }
}
