{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "categories": {
    "correctness": "error",
    "pedantic": "warn"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-debugger": "error",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "src-tauri/**",
    "node_modules/**"
  ]
}
