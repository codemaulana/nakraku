{
  "name": "nakraku-stash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:extension": "node scripts/package-extension.mjs",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "audit:keyboard": "node scripts/keyboard-audit.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm test && npm run test:rust",
    "checksums": "powershell -ExecutionPolicy Bypass -File scripts/generate-checksums.ps1",
    "sign:release": "powershell -ExecutionPolicy Bypass -File scripts/sign-release.ps1",
    "perf:gate": "node scripts/perf-regression-gate.mjs",
    "ci:all": "npm run lint && npm run check && npm run test:coverage && npm run test:rust && npm run build && npm run perf:gate",
    "prepare": "lefthook install",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-visualizer": "^7.1.2",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "lefthook": "^2.2.2",
    "oxlint": "^1.92.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
